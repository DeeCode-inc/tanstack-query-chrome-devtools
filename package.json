{
  "name": "tanstack-query-chrome-devtools",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "TanStack Query DevTools",
  "license": "MIT",
  "homepage": "https://github.com/DeeCode-inc/tanstack-query-chrome-devtools#readme",
  "repository": {
    "type": "git",
