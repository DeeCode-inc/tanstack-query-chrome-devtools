{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Generated by `oxfmt --migrate biome`, so the output keeps the formatting
  // the Biome setup produced (which itself matched the earlier Prettier one).
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  // Biome left package.json key order alone; keep it that way.
  "sortPackageJson": false,
  // Replaces Biome's `organizeImports` assist: one block per blank-line-
  // separated chunk, packages first, then `@/` aliases, then relative paths.
  "sortImports": {
    "newlinesBetween": false,
    "partitionByNewline": true
  },
  // The `specs` git submodule and the Spec Kit scaffolding are vendored, so
  // they stay out of formatting. Everything in .gitignore is skipped already.
  "ignorePatterns": ["specs", ".specify", ".github/agents", ".github/prompts"]
}
